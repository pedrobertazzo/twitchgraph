# Create an app at dev.twitch.tv/console/apps (any redirect URL works; the app only uses the client-credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# The public address of this deployment.
APP_URL=https://twitch.morphgrid.io

# Shared store for the background refresher (Vercel: Storage -> Upstash for Redis sets these). Empty locally = memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Who may run /api/refresh: QStash's signing keys (added when QStash is connected) or "Authorization: Bearer <CRON_SECRET>".
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=
